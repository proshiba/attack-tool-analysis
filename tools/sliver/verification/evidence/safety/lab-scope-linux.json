{
  "schema_version": 3,
  "rule": "SAFETY RULE 1 - attack activity never leaves the isolated lab",
  "claim": "no traffic attributable to the declared attack left the lab, and everything else that did is in the manifest",
  "allowed_networks": [
    "192.168.1.0/24"
  ],
  "allowed_domains": [
    "c2.sliver.lab"
  ],
  "management_networks": [
    "10.9.0.0/24"
  ],
  "declared_tool_images": [
    "http-beacon",
    ".cache-update-6f32",
    "https-beacon",
    ".lib-cache-93a1",
    "mtls-session",
    ".dbus-helper-417",
    "dns-beacon",
    ".net-cache-284e",
    "curl"
  ],
  "inputs": {
    "zeek_dir": "/tmp/sliver-scope-combined-v2",
    "sysmon_json": "/tmp/sliver-scope-combined-v2/network.json",
    "operator_logs": [
      "/tmp/sliver-listeners-generate.rc",
      "/tmp/sliver-generate-retry.rc",
      "/tmp/sliver-http-tasks.rc",
      "/tmp/sliver-http-results.rc",
      "/tmp/sliver-http-fetch.rc",
      "/tmp/sliver-https-tasks.rc",
      "/tmp/sliver-https-results.rc",
      "/tmp/sliver-mtls-tasks.rc",
      "/tmp/sliver-dns-generate.rc",
      "/tmp/sliver-dns-actions.rc",
      "/tmp/sliver-dns-tasks.rc",
      "/tmp/sliver-dns-fetch.rc"
    ],
    "sysmon_eid3_events_read": 33,
    "sysmon_eid22_events_read": 0,
    "attributed_destinations": 2,
    "attribution_available": true
  },
  "capture_scale": {
    "conn_log_rows": 126,
    "off_lab_destinations": 0,
    "note": "a capture pre-filtered to in-lab traffic cannot show an off-lab destination, so 0 here proves nothing on its own - never filter the input"
  },
  "violation_count": 0,
  "violations": [],
  "manifest_count": 1,
  "manifest": [
    {
      "check": "dns.log",
      "severity": "info",
      "query": "ntp.ubuntu.com",
      "queries": 48,
      "resolver": "192.168.1.50",
      "scope": "external-name-queried-in-lab",
      "detail": "'ntp.ubuntu.com' asked of in-lab resolver 192.168.1.50 (48 queries)"
    }
  ],
  "verdict": "PASS"
}
